# Google Cloud project where the Google Ads API and OAuth client are configured.
GOOGLE_PROJECT_ID=your-google-cloud-project-id

# Google Ads API access. Treat the developer token like a password.
GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-developer-token

# Optional. Set this to the manager (MCC) customer ID, digits only, when the
# target Ads account is accessed through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Public origin only, HTTPS, no trailing slash.
# The MCP endpoint will be <base-url>/mcp.
# Register <base-url>/auth/callback in the Google OAuth client.
GOOGLE_ADS_MCP_BASE_URL=https://google-ads-mcp.example.com

# Stable secrets are required so OAuth sessions survive container restarts.
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=replace-with-long-random-secret
GOOGLE_ADS_MCP_STORAGE_ENCRYPTION_KEY=replace-with-another-long-random-secret
GOOGLE_ADS_MCP_STORAGE_DISABLE_ENCRYPTION=false

# Simple single-instance POC persistence. Mount a persistent volume at /data.
GOOGLE_ADS_MCP_STORAGE_TYPE=filetree
GOOGLE_ADS_MCP_STORAGE_PATH=/data/oauth

# Railway normally injects PORT. This value is useful for local Docker runs.
PORT=8080
